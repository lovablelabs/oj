+  /// Creates the code caches deferred at compile time that are due. A cache
+  /// created right after compiling holds only the top-level code (V8
+  /// compiles functions lazily), so every function a module ran missed again
+  /// on the next load. Node creates its compile cache at exit for the same
+  /// reason: here a module's cache is created once it has had
+  /// `CODE_CACHE_DELAY` to run, a few milliseconds of it per event loop
+  /// tick, and whatever is left when the realm is destroyed (a one-shot
+  /// runtime's exit).
+  pub(crate) fn create_due_code_caches(
+    &self,
+    scope: &mut v8::PinScope,
+    waker: &std::task::Waker,
+  ) {
+    const CODE_CACHE_DELAY: std::time::Duration =
+      std::time::Duration::from_secs(2);
+    const TICK_BUDGET: std::time::Duration =
+      std::time::Duration::from_millis(4);
+    let started = std::time::Instant::now();
+    loop {
+      let due_at = match self.deferred_code_caches.borrow().front() {
+        Some(next) => next.compiled_at + CODE_CACHE_DELAY,
+        None => return,
+      };
+      let now = std::time::Instant::now();
+      if now < due_at {
+        self.wake_at(due_at, waker);
+        return;
+      }
+      if now - started >= TICK_BUDGET {
+        waker.wake_by_ref();
+        return;
+      }
+      let next = self.deferred_code_caches.borrow_mut().pop_front();
+      if let Some(next) = next {
+        self.create_code_cache(scope, next);
+      }
+    }
   }
 
+  /// Creates every deferred code cache still pending.
+  pub(crate) fn create_deferred_code_caches(&self, scope: &mut v8::PinScope) {
+    let deferred = std::mem::take(&mut *self.deferred_code_caches.borrow_mut());
+    for next in deferred {
+      self.create_code_cache(scope, next);
+    }
+    // Teardown polls no more: a callback that finishes synchronously lands
+    // now, any other is dropped with the map.
+    let mut cx = Context::from_waker(std::task::Waker::noop());
+    while let Poll::Ready(Some(_)) =
+      self.code_cache_ready_futs.poll_next_unpin(&mut cx)
+    {}
+  }
+
+  fn create_code_cache(&self, scope: &mut v8::PinScope, next: DeferredCodeCache) {
+    let module = v8::Local::new(scope, next.module);
+    if module.get_status() == v8::ModuleStatus::Errored {
+      return;
+    }
+    let Some(code_cache) =
+      module.get_unbound_module_script(scope).create_code_cache()
+    else {
+      return;
+    };
+    let fut = (next.info.ready_callback)(&code_cache);
+    self.code_cache_ready_futs.push(fut);
+  }
+
+  /// Wakes the event loop at `at`, once per pending wait.
+  fn wake_at(&self, at: std::time::Instant, waker: &std::task::Waker) {
+    use std::sync::atomic::Ordering;
+    if self.code_cache_wake_scheduled.swap(true, Ordering::AcqRel) {
+      return;
+    }
+    let scheduled = self.code_cache_wake_scheduled.clone();
+    let waker = waker.clone();
+    let spawned = std::thread::Builder::new()
+      .name("deno_core-code-cache-wake".into())
+      .spawn(move || {
+        std::thread::sleep(at.saturating_duration_since(std::time::Instant::now()));
+        scheduled.store(false, Ordering::Release);
+        waker.wake();
+      });
+    if spawned.is_err() {
+      self.code_cache_wake_scheduled.store(false, Ordering::Release);
+    }
+  }
