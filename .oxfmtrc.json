{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/oxfmt_v0.71.0/npm/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "ignorePatterns": [
    "reference/**",
    "crates/oj_server/src/assets/start/glob-libs.mjs",
    "crates/oj_deno_*/**",
    "crates/typecheck/oj_tsrs_*/**",
    "e2e/fixtures/**",
    "crates/oj_stylex/conformance/**",
    "crates/oj_stylex/testdata/**",
    "crates/oj/src/build/vite_preload/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/*.gen.ts",
    "target*/**"
  ]
}
